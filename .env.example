# ===========================
# Application
# ===========================
PORT=3000
NODE_ENV=development
# CORS \ud654\uc774\ud2b8\ub9ac\uc2a4\ud2b8 (CSV). \ubbf8\uc9c0\uc815 + production \uc774\uba74 \ubaa8\ub450 \ucc28\ub2e8.
# \uc608: https://app.lookup.app,https://admin.lookup.app
CORS_ORIGINS=

# ===========================
# Database (PostgreSQL)
# ===========================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=recognize_user
DB_PASSWORD=
DB_DATABASE=recognize_dev

# ===========================
# TypeORM
# ===========================
# 운영에서는 반드시 false. 마이그레이션으로 스키마 관리.
DB_SYNCHRONIZE=true
DB_LOGGING=true
# 부팅 시 자동 마이그레이션 실행 (운영 권장)
DB_MIGRATIONS_RUN=false
# RDS 등 SSL 강제 환경에서 true (운영 필수)
DB_SSL=false

# ===========================
# Kakao OAuth
# ===========================
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# ===========================
# JWT
# ===========================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ===========================
# Storage
# ===========================
# local | s3
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# ===========================
# AWS S3 (STORAGE_DRIVER=s3 인 경우에만 필요)
# ===========================
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
# 선택: CloudFront/커스텀 도메인 사용 시. 지정하지 않으면 s3 virtual-hosted URL 사용.
AWS_S3_PUBLIC_URL=
# ECS/EC2 IAM Role 사용 시 아래 두 값은 비워두세요.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
