# ===========================
# Application
# ===========================
PORT=3000
NODE_ENV=development

# ===========================
# Database (PostgreSQL)
# ===========================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=recognize_user
DB_PASSWORD=
DB_DATABASE=recognize_dev

# ===========================
# TypeORM
# ===========================
DB_SYNCHRONIZE=true
DB_LOGGING=true

# ===========================
# Kakao OAuth
# ===========================
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# ===========================
# JWT
# ===========================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d